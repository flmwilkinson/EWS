# Copy to .env and fill in. Real environment variables take precedence.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional
# EWS_LLM_EFFORT=low          # low keeps commentary fast; medium or high for deeper analysis
# EWS_N_CUSTOMERS=12000       # book size; 8000 runs faster and needs less memory
# EWS_MAX_PARALLEL=2          # pipeline tasks run at once; 1 on a machine short of memory
# EWS_PORT=8765
